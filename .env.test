# valores usados pela suíte de testes — Argon2 no custo mínimo para a suíte não arrastar.
# NUNCA use estes parâmetros em produção: eles tornam o hash barato de quebrar.
APP_ENV=test
LOG_LEVEL=WARNING
JWT_SECRET=segredo-apenas-para-testes-com-32-bytes-ou-mais
ARGON2_TIME_COST=1
ARGON2_MEMORY_COST=8
ARGON2_PARALLELISM=1
