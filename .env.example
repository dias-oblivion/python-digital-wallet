# copie para .env e ajuste
APP_ENV=local
LOG_LEVEL=INFO
# true (default) = uma linha JSON por evento; false = saída colorida para o terminal
LOG_JSON=true

# a app usa esta DSN direto no asyncpg; o Alembic deriva a versão postgresql+asyncpg://
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet
DB_POOL_MIN=1
DB_POOL_MAX=10

# HS256 exige >= 32 bytes (RFC 7518). Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-valor-antes-de-qualquer-coisa-seria-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# custo do Argon2 em produção (RFC 9106, segundo perfil recomendado)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
